{
  "name": "prompt-heist",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/src/main.js",
    "test": "node --test server/test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 server/test/*.test.js",
    "test:protocol": "node --test server/test/protocol.test.js server/test/room-registry.test.js",
    "test:integration": "node --test server/test/server.integration.test.js",
    "verify:manual-protocol": "node scripts/manual_protocol_check.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ws": "8.22.0"
  }
}
